# UniSphere Server Environment Configuration

# Server & CORS
PORT=3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Database (MongoDB 8.0 Replica Set)
DATABASE_URL=mongodb://root:password@localhost:27017/UniSphere_cor?authSource=admin&directConnection=true

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_for_security
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis / BullMQ Job Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Nodemailer / SMTP (Use ethereal.email for local testing)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@unisphere.charusat.ac.in

# Cloudinary CDN (Poster media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenTelemetry / Observability
OTEL_SERVICE_NAME=unisphere-server
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
